# Vorlage fuer die env-Dateien auf dem Beelink:
#   ~/knipsa-env/dev.env  und  ~/knipsa-env/prod.env
#
# Nur Variablennamen, nie Werte — Werte stehen ausschliesslich auf dem Host.
# Die Datei wird vom Deploy ueber --env-file eingelesen und zusaetzlich als
# env_file an den server-Container gegeben (siehe deploy/docker-compose.yml).

# dev oder prod
KNIPSA_ENV=
# Port am Host, nur an 192.168.2.200 gebunden (dev 8098, prod 8099)
KNIPSA_PORT=
# Oeffentliche Adresse der Umgebung, vorerst die LAN-URL
APP_ORIGIN=

# Postgres im Compose-Netz (kein Port am Host)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Verbindung des Servers zur Datenbank, Host ist der Compose-Dienst `db`
DATABASE_URL=

# Wurzel des Foto-Baums auf dem Host; im Container immer unter /fotos
FOTOS_ROOT=
# Wurzel der Import-Quellen auf dem Host; im Container nur lesend
# unter /quellen (req-005)
QUELLEN_ROOT=
# Eingestellte Import-Quellen als Name=Pfad, mehrere mit ; getrennt,
# zum Beispiel Test=/quellen/test. Leer heisst: keine Quelle.
IMPORT_QUELLEN=
# Ordner auf dem Host, unter dem eingesteckte Datentraeger nur lesend
# eingehaengt erscheinen (auf dem Beelink /media/knipsa, siehe
# deploy/host/automount/); im Container unter /datentraeger (req-006)
DATENTRAEGER_ROOT=
